{
  "name": "togotravel",
  "private": true,
  "scripts": {
    "dev:join": "npm run dev --prefix join",
    "dev:joinUp": "npm run dev --prefix joinUp",
    "dev:trip-vibe": "npm run dev --prefix trip-vibe",
    "build": "npm run build:join && npm run build:joinUp && npm run build:trip-vibe",
    "build:join": "npm run build --prefix join",
    "build:joinUp": "npm run build --prefix joinUp",
    "build:trip-vibe": "npm run build --prefix trip-vibe",
    "audit": "npm run audit:join; npm run audit:joinUp; npm run audit:trip-vibe",
    "audit:join": "npm audit --prefix join",
    "audit:joinUp": "npm audit --prefix joinUp",
    "audit:trip-vibe": "npm audit --prefix trip-vibe"
  }
}
